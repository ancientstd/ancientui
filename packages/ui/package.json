{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
  "name": "ancientstd",
  "version": "1.0.0",
  "description": "A Modern and Minimal React UI Library built with TailwindCSS.",
  "keywords": [
    "ui",
    "component",
    "react",
    "react-component",
    "ancientui"
  ],
  "author": "Ancient Studio",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "clean:all": "rimraf .turbo && rimraf node_modules",
    "dev": "concurrently \"tsc -w --project tsconfig.build.json\" \"tsc-alias -w -p tsconfig.build.json\"",
    "prebuild": "node scripts/generate-index.js",
    "build": "pnpm prebuild && tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "eslint .",
    "types:check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancientstd/ancientui.git"
  },
  "homepage": "https://ui.ancientstd.com",
  "dependencies": {
    "@internationalized/date": "^3.8.0",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@react-aria/i18n": "^3.12.8",
    "@react-stately/calendar": "^3.8.0",
    "@react-stately/color": "^3.8.4",
    "@react-types/overlays": "^3.8.14",
    "ancient-icons": "workspace:*",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "motion": "^12.9.4",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-aria": "^3.39.0",
    "react-aria-components": "^1.8.0",
    "react-stately": "^3.37.0",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.5",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/react": "^19.1.2",
    "postcss": "^8.5.3",
    "tailwind-merge": "^3.2.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.5",
    "tsc-alias": "^1.8.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
